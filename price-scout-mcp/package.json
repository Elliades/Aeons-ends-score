{
  "name": "price-scout-mcp",
  "version": "1.0.0",
  "description": "MCP server for price research, deals, and second-hand marketplace scraping",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "price-scout-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "price",
    "deals",
    "leboncoin",
    "amazon",
    "dealabs",
    "scraping"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cheerio": "^1.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
